# Single config file for the whole project. Copy to .env: cp .env.example .env
# Read by docker compose (${...} in docker-compose.yml) and by pos-api (godotenv)
# when run from this folder. Real environment variables take precedence.

POSTGRES_PASSWORD=postgres

# pos-api, run locally against the compose database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pos
